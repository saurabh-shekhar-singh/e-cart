{
  "include": ["src", "src/test"],
  "compilerOptions": {
    "composite": true,
    "declaration": true,
    "noEmit": false,
    "ignoreDeprecations": "6.0",
    "esModuleInterop": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@test/*": ["src/test/*"],
      "@public/*": ["public/*"],
      "@types/*": ["types/*"],
      "@utils/*": ["src/utils/*"],
      "@components/*": ["src/components/*"],
      "@hooks/*": ["src/hooks/*"],
      "@services/*": ["src/services/*"],
      "@models/*": ["src/models/*"],
      "@assets/*": ["src/assets/*"],
      "@styles/*": ["src/styles/*"],
      "@contexts/*": ["src/contexts/*"],
      "@pages/*": ["src/pages/*"]
    },
    "resolveJsonModule": true,
    "moduleResolution": "node",
    "jsx": "react-jsx",
    "types": ["@testing-library/jest-dom"]
  },
}
